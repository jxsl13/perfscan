package ps5002

func gram(m [][]float64, x []float64) {
	for i := range x {
		for j := 0; j <= i; j++ {
			m[i][j] += x[i] * x[j]
		}
	}
	for i := range x { // mirror once
		for j := i + 1; j < len(x); j++ {
			m[i][j] = m[j][i]
		}
	}
}

// Counted form with a shared bound: fixed the same way.
func gramCounted(m [][]float64, x []float64, n int) {
	for i := 0; i < n; i++ {
		for j := 0; j <= i; j++ {
			m[i][j] += x[i] * x[j]
		}
	}
	for i := 0; i < n; i++ { // mirror once
		for j := i + 1; j < n; j++ {
			m[i][j] = m[j][i]
		}
	}
}

// Counted form bounded by len(x) on both loops: fixed.
func gramLen(m [][]float64, x []float64) {
	for i := 0; i < len(x); i++ {
		for j := 0; j <= i; j++ {
			m[i][j] += x[i] * x[j]
		}
	}
	for i := 0; i < len(x); i++ { // mirror once
		for j := i + 1; j < len(x); j++ {
			m[i][j] = m[j][i]
		}
	}
}

// Already triangular: silent.
func triangle(m [][]float64, x []float64) {
	for i := range x {
		for j := 0; j <= i; j++ {
			m[i][j] += x[i] * x[j]
		}
	}
}

// Different vectors are not symmetric: silent.
func outer(m [][]float64, x, y []float64) {
	for i := range x {
		for j := range y {
			m[i][j] += x[i] * y[j]
		}
	}
}

// Extra statement in the inner body: advisory only, no automatic fix.
func fusedTrace(m [][]float64, x, trace []float64) {
	for i := range x {
		for j := range x {
			m[i][j] += x[i] * x[j] // want `m\[i\]\[j\] accumulates a symmetric product over full ranges of i and j — every off-diagonal element is computed twice; accumulate one triangle and mirror it once \(bit-identical\)`
			trace[i] += m[i][j]
		}
	}
}

// Counted bounds that differ textually: advisory only, no automatic fix.
func mismatchedBounds(m [][]float64, x []float64, n, k int) {
	for i := 0; i < n; i++ {
		for j := 0; j < k; j++ {
			m[i][j] += x[i] * x[j] // want `m\[i\]\[j\] accumulates a symmetric product over full ranges of i and j — every off-diagonal element is computed twice; accumulate one triangle and mirror it once \(bit-identical\)`
		}
	}
}

// Transposed target m[j][i]: advisory only, no automatic fix.
func transposed(m [][]float64, x []float64) {
	for i := range x {
		for j := range x {
			m[j][i] += x[i] * x[j] // want `m\[j\]\[i\] accumulates a symmetric product over full ranges of i and j — every off-diagonal element is computed twice; accumulate one triangle and mirror it once \(bit-identical\)`
		}
	}
}

package ps2005

import rx "regexp"

// Aliased regexp import: PS2005 detection is path-based (astutil.PkgFuncCall
// resolves the import path, not the local name), so an aliased `rx.MustCompile`
// in a loop IS flagged and hoisted. hoistRegexpFix renders the qualifier from
// source, so the hoisted binding correctly reads `rx.MustCompile(...)` (not a
// hardcoded `regexp.`), keeping the rewrite compilable under the alias.
func aliasedInLoop(lines []string) int {
	n := 0
	psRe13 := rx.MustCompile("^a+$")
	for _, s := range lines {
		if psRe13.MatchString(s) { // want `regexp\.MustCompile inside a loop recompiles an invariant pattern every iteration; hoist it out of the loop`
			n++
		}
	}
	return n
}

package ps3027

import (
	sl "slices"
)

// An aliased slices import: the fix keeps the file's qualifier.
func compareAliased(a, b []int) int {
	return sl.Compare(a, b) // want `slices\.Compare compares the int elements with the identical lexicographic result and the comparison inlined`
}

// A parenthesized comparator still matches and rewrites.
func compareParens(a, b []uint16) int {
	return sl.Compare(a, b) // want `slices\.Compare compares the uint16 elements with the identical lexicographic result and the comparison inlined`
}

package ps5034

import (
	"strings"
	"unicode"
)

// One advisory site (comment in the deleted scaffolding) plus one
// fixable site: the advisory site KEEPS its unicode reference, so the
// import must survive even though the fixable rewrite removes one.
func mixedFixable(s string) []string {
	return strings.Fields(s) // want `strings\.FieldsFunc\(s, unicode\.IsSpace\) decodes every rune`
}

func mixedAdvisory(s string) []string {
	return strings.FieldsFunc(s /* whitespace */, unicode.IsSpace) // want `strings\.FieldsFunc\(s, unicode\.IsSpace\) decodes every rune`
}

package ps3104

import (
	"slices"
)

// slices is ALREADY imported: the fix must not duplicate the import, and
// the now-orphaned sort spec is deleted from the group.
func alreadySlices(xs []int) {
	slices.Sort(xs) // want `sort\.Ints is the legacy spelling of slices\.Sort \(an interface-dispatch sort on go1\.21, a one-line wrapper since go1\.22\); slices\.Sort sorts the concrete \[\]int directly with the identical ascending order`
	slices.Reverse(xs)
}

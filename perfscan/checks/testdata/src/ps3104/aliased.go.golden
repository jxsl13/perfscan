package ps3104

import (
	sl "slices"
)

// slices is imported under an ALIAS: the fix spells the call with the
// alias and deletes the now-orphaned sort spec.
func aliasedSlices(xs []int) {
	sl.Sort(xs) // want `sort\.Ints is the legacy spelling of slices\.Sort \(an interface-dispatch sort on go1\.21, a one-line wrapper since go1\.22\); slices\.Sort sorts the concrete \[\]int directly with the identical ascending order`
	sl.Reverse(xs)
}

package ps2009

import (
	"bytes"
	"strings"
)

// Literal separator: the classic head read.
func head(s string) string {
	first := strings.SplitN(s, ",", 2)[0] // want `strings\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; strings\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
	return first
}

// A VARIABLE separator is fine — the head identity holds for every
// separator value, including the empty string (unlike strings.Cut).
func varSep(s, sep string) string {
	return strings.SplitN(s, sep, 2)[0] // want `strings\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; strings\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
}

// The EMPTY separator is fine too: both forms rune-explode and return
// the first rune (this is exactly where strings.Cut would diverge).
func emptySep(s string) string {
	return strings.SplitN(s, "", 2)[0] // want `strings\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; strings\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
}

// Parenthesized operand: still a direct index of the call.
func parenthesized(s string) string {
	return (strings.SplitN(s, ",", 2))[0] // want `strings\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; strings\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
}

// A named constant that evaluates to 0 is the same index.
const zero = 0

func namedZero(s string) string {
	return strings.SplitN(s, ",", 2)[zero] // want `strings\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; strings\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
}

// A comment after the separator argument survives: the fix INSERTS
// ", 2" directly after the argument instead of rewriting the span up
// to the closing parenthesis.
func commented(s string) string {
	return strings.SplitN(s, ",", 2 /* sep */)[0] // want `strings\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; strings\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
}

// bytes twin: same head, same capped subslice of the same backing array.
func bytesHead(b []byte) []byte {
	return bytes.SplitN(b, []byte(","), 2)[0] // want `bytes\.Split\(\.\.\.\)\[0\] scans the whole input and allocates every piece just to read the head; bytes\.SplitN\(\.\.\., 2\)\[0\] stops at the first separator and is bit-identical`
}

// --- guards: none of the following may be reported or rewritten ---

// [1] needs the second piece — SplitN(..., 2)[1] would be the UNSPLIT
// remainder, a different value. Out of scope.
func second(s string) string {
	return strings.Split(s, ",")[1]
}

// A variable index may be nonzero at run time.
func varIndex(s string, i int) string {
	return strings.Split(s, ",")[i]
}

// A named nonzero constant likewise.
const one = 1

func namedOne(s string) string {
	return strings.Split(s, ",")[one]
}

// The result stored first may have other consumers — out of scope.
func storedFirst(s string) string {
	parts := strings.Split(s, ",")
	return parts[0]
}

// Already limited: nothing to gain.
func alreadyN(s string) string {
	return strings.SplitN(s, ",", 2)[0]
}

// SplitAfter keeps the separator attached — a different function, out
// of scope for this check.
func splitAfter(s string) string {
	return strings.SplitAfter(s, ",")[0]
}

// A shadowed strings is not the strings package.
type fakeStrings struct{}

func (fakeStrings) Split(s, sep string) []string { return []string{s} }

func shadowedPkg(s string) string {
	strings := fakeStrings{}
	return strings.Split(s, ",")[0]
}

// Slicing (not indexing) the result is out of scope.
func sliced(s string) []string {
	return strings.Split(s, ",")[0:1]
}

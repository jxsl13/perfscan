package ps3029

import (
	"fmt"
	"maps"
	"slices"
)

type Rank int

// The hand-rolled three-way if-chain under the STABLE collecting sort is
// slices.Sorted spelled the slow, stable way; the seq expression is kept
// verbatim. (The fixture comparators are one-liners because the `want`
// comment must share the call's line, and a comment INSIDE the deleted span
// keeps a report advisory — see advisory.go; the AST shapes are identical to
// the multi-line spellings.)
func sortedVals(m map[string]int) []int {
	return slices.Sorted(maps.Values(m)) // want `slices\.SortedStableFunc with a hand-rolled three-way comparator \(a<b/a>b/-1/1/0\) pays an indirect comparator call plus up to two relational comparisons per comparison and the stable sort's merge overhead; slices\.Sorted collects and sorts the int elements with the identical ascending order, a single inlined comparison and no stability cost`
}

// The if/else-if chain with a trailing return is the same three-way, and
// STRING elements are fixable too (equal strings are byte-identical, so the
// stable tie-order guarantee buys nothing observable).
func sortedKeys(m map[string]int) []string {
	return slices.Sorted(maps.Keys(m)) // want `slices\.Sorted collects and sorts the string elements with the identical ascending order, a single inlined comparison and no stability cost`
}

// The fully chained if/else-if/else spelling maps identically.
func sortedChained(xs []int) []int {
	return slices.Sorted(slices.Values(xs)) // want `slices\.Sorted collects and sorts the int elements with the identical ascending order, a single inlined comparison and no stability cost`
}

// An expressionless switch with a default clause is the same three-way, and
// a NAMED ordered element is fixed too: sorting orders by the ordered value,
// equal values are identical bytes, and a String() method on the element is
// never consulted.
func sortedNamed(rs []Rank) []Rank {
	return slices.Sorted(slices.Values(rs)) // want `slices\.Sorted collects and sorts the Rank elements with the identical ascending order, a single inlined comparison and no stability cost`
}

// A switch without a default clause plus the trailing return matches too;
// parameter names are matched by object identity, not spelling, and the seq
// expression is kept verbatim, however it is spelled.
func sortedField(w struct{ ids map[int]uint64 }) []uint64 {
	return slices.Sorted(maps.Values(w.ids)) // want `slices\.Sorted collects and sorts the uint64 elements with the identical ascending order, a single inlined comparison and no stability cost`
}

// The two arms in SWAPPED order (greater first), the b</b> operand
// spellings, and magnitudes other than 1 are the same three-way — only the
// SIGN is consumed. The two-field parameter spelling func(a T, b T) matches
// like func(a, b T), and a unary +1 is a positive literal like 1.
func sortedSwapped(xs []int) {
	fmt.Println(slices.Sorted(slices.Values(xs))) // want `slices\.Sorted collects and sorts the int elements with the identical ascending order, a single inlined comparison and no stability cost`
	fmt.Println(slices.Sorted(slices.Values(xs))) // want `slices\.Sorted collects and sorts the int elements with the identical ascending order, a single inlined comparison and no stability cost`
}

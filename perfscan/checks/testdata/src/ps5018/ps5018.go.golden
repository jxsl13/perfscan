package ps5018

import (
	"strings"
)

// The mapping arguments are this file's ONLY unicode references, so the
// fix also drops the orphaned unicode import (the runner never prunes
// imports itself). The strings import stays: the rewrite keeps the
// qualifier and merely renames Map.
func upperBasic(s string) string {
	return strings.ToUpper(s) // want `strings\.Map\(unicode\.ToUpper, s\) pays`
}

func lowerBasic(s string) string {
	return strings.ToLower(s) // want `strings\.Map\(unicode\.ToLower, s\) pays`
}

// The haystack is kept byte-verbatim, however it is spelled: a field
// selector, a compound expression with a call (evaluated exactly once
// in both forms), a conversion, and a parenthesized mapping argument.
type name string

func verbatim(w struct{ s string }, f func() string, n name) {
	_ = strings.ToUpper(w.s)       // want `strings\.Map\(unicode\.ToUpper, s\) pays`
	_ = strings.ToLower(f() + "!") // want `strings\.Map\(unicode\.ToLower, s\) pays`
	_ = strings.ToUpper(string(n)) // want `strings\.Map\(unicode\.ToUpper, s\) pays`
	_ = strings.ToLower(w.s)       // want `strings\.Map\(unicode\.ToLower, s\) pays`
}

// A nested match sits inside the kept haystack span: both sites are
// rewritten (the edits never overlap).
func nested(s string) string {
	return strings.ToUpper(strings.ToLower(s)) // want `strings\.Map\(unicode\.ToUpper, s\) pays` `strings\.Map\(unicode\.ToLower, s\) pays`
}

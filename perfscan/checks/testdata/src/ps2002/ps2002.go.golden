package ps2002

import (
	"bytes"
	"strings"
)

func unsized(parts []string) string {
	var b strings.Builder
	psTotal10 := 0
	for _, s := range parts {
		psTotal10 += len(s)
	}
	b.Grow(psTotal10)
	for _, s := range parts {
		b.WriteString(s) // want `b is written in a loop with no b\.Grow call in this function; a capacity hint removes the geometric growth copies`
	}
	return b.String()
}

func sized(parts []string, total int) string {
	var b strings.Builder
	b.Grow(total)
	for _, s := range parts {
		b.WriteString(s)
	}
	return b.String()
}

func buffer(parts [][]byte) []byte {
	var buf bytes.Buffer
	for _, p := range parts {
		buf.Write(p) // want `buf is written in a loop with no buf\.Grow call in this function; a capacity hint removes the geometric growth copies`
	}
	return buf.Bytes()
}

func outsideLoop(s string) string {
	var b strings.Builder
	b.WriteString(s)
	return b.String()
}

// Advisory only: two writes in the loop body, the total is not the plain sum.
func multiWrite(parts []string) string {
	var b strings.Builder
	for _, s := range parts {
		b.WriteString(s) // want `b is written in a loop with no b\.Grow call in this function; a capacity hint removes the geometric growth copies`
		b.WriteString(",")
	}
	return b.String()
}

// Advisory only: the argument is derived from the range value, not the value
// itself.
func derivedArg(parts []string) string {
	var b strings.Builder
	for _, s := range parts {
		b.WriteString(s + ",") // want `b is written in a loop with no b\.Grow call in this function; a capacity hint removes the geometric growth copies`
	}
	return b.String()
}

// Advisory only: the range source is a call, not a plain identifier, so
// re-ranging it to pre-count is not known to be side-effect free.
func nonIdentSrc(csv string) string {
	var b strings.Builder
	for _, s := range strings.Split(csv, ",") {
		b.WriteString(s) // want `b is written in a loop with no b\.Grow call in this function; a capacity hint removes the geometric growth copies`
	}
	return b.String()
}

// Advisory only: an index-based for loop, not the range-value shape.
func indexLoop(parts []string) string {
	var b strings.Builder
	for i := 0; i < len(parts); i++ {
		b.WriteString(parts[i]) // want `b is written in a loop with no b\.Grow call in this function; a capacity hint removes the geometric growth copies`
	}
	return b.String()
}

package ps2029

import (
	"bytes"
	"strings"
	str "strings"
)

// Every membership-equivalent comparison shape is rewritten, with the
// literal on either side of the operator. The two-byte separator keeps
// the plain Contains form.
func forms(s string) {
	_ = strings.Contains(s, "=>")  // want `len\(strings\.SplitN\(s, "=>", 2\)\) == 2 allocates the up-to-two-piece slice just to test for the separator; strings\.Contains\(s, "=>"\) is the identical boolean with zero allocation`
	_ = strings.Contains(s, "=>")  // want `len\(strings\.SplitN\(s, "=>", 2\)\) >= 2 allocates the up-to-two-piece slice just to test for the separator; strings\.Contains\(s, "=>"\)`
	_ = strings.Contains(s, "=>")  // want `len\(strings\.SplitN\(s, "=>", 2\)\) > 1 allocates the up-to-two-piece slice just to test for the separator; strings\.Contains\(s, "=>"\)`
	_ = strings.Contains(s, "=>")  // want `len\(strings\.SplitN\(s, "=>", 2\)\) != 1 allocates the up-to-two-piece slice just to test for the separator; strings\.Contains\(s, "=>"\)`
	_ = !strings.Contains(s, "=>") // want `len\(strings\.SplitN\(s, "=>", 2\)\) == 1 allocates the up-to-two-piece slice just to test for the separator; !strings\.Contains\(s, "=>"\)`
	_ = !strings.Contains(s, "=>") // want `len\(strings\.SplitN\(s, "=>", 2\)\) <= 1 allocates the up-to-two-piece slice just to test for the separator; !strings\.Contains\(s, "=>"\)`
	_ = !strings.Contains(s, "=>") // want `len\(strings\.SplitN\(s, "=>", 2\)\) < 2 allocates the up-to-two-piece slice just to test for the separator; !strings\.Contains\(s, "=>"\)`
	_ = !strings.Contains(s, "=>") // want `len\(strings\.SplitN\(s, "=>", 2\)\) != 2 allocates the up-to-two-piece slice just to test for the separator; !strings\.Contains\(s, "=>"\)`
	_ = strings.Contains(s, "=>")  // want `2 == len\(strings\.SplitN\(s, "=>", 2\)\) allocates the up-to-two-piece slice just to test for the separator; strings\.Contains\(s, "=>"\)`
	_ = strings.Contains(s, "=>")  // want `2 <= len\(strings\.SplitN\(s, "=>", 2\)\) allocates the up-to-two-piece slice just to test for the separator; strings\.Contains\(s, "=>"\)`
	_ = !strings.Contains(s, "=>") // want `1 >= len\(strings\.SplitN\(s, "=>", 2\)\) allocates the up-to-two-piece slice just to test for the separator; !strings\.Contains\(s, "=>"\)`
	_ = !strings.Contains(s, "=>") // want `2 > len\(strings\.SplitN\(s, "=>", 2\)\) allocates the up-to-two-piece slice just to test for the separator; !strings\.Contains\(s, "=>"\)`
}

// An aliased import keeps its qualifier verbatim; Contains lives in
// the same package, so the import is never orphaned.
func aliased(s string) bool {
	return str.Contains(s, "=>") // want `len\(str\.SplitN\(s, "=>", 2\)\) == 2 allocates the up-to-two-piece slice just to test for the separator; str\.Contains\(s, "=>"\)`
}

// A one-byte string literal separator chains to the IndexByte fixed
// point directly (emitting Contains would hand PS5016 its Before-shape
// and churn the next -fix pass). A multi-byte rune that is one RUNE but
// two BYTES stays a plain Contains, as does a one-byte NAMED constant
// (advisory-only in PS5016, so no churn).
const arrow = "=>"

const eq = "="

func oneByte(line string) {
	if strings.IndexByte(line, "="[0]) >= 0 { // want `len\(strings\.SplitN\(line, "=", 2\)\) == 2 allocates the up-to-two-piece slice just to test for the separator; strings\.IndexByte\(line, "="\[0\]\) >= 0`
		return
	}
	_ = strings.IndexByte(line, "="[0]) < 0     // want `strings\.IndexByte\(line, "="\[0\]\) < 0`
	_ = strings.IndexByte(line, "\xff"[0]) >= 0 // want `strings\.IndexByte\(line, "\\xff"\[0\]\) >= 0`
	_ = strings.Contains(line, "é")             // want `strings\.Contains\(line, "é"\)`
	_ = strings.Contains(line, arrow)           // want `strings\.Contains\(line, arrow\)`
	_ = strings.Contains(line, eq)              // want `strings\.Contains\(line, eq\)`
}

// The bytes twin: multi-byte needles keep the plain Contains form; a
// one-element []byte{X} composite and a []byte("z") conversion of a
// one-byte literal chain to bytes.IndexByte (PS5014's fixed point),
// with X carried over verbatim and evaluated exactly once.
func bytesTwin(b []byte, sepByte byte, next func() byte) {
	_ = bytes.Contains(b, []byte("=>"))     // want `bytes\.Contains\(b, \[\]byte\("=>"\)\)`
	_ = bytes.Contains(b, []byte{'a', 'b'}) // want `bytes\.Contains\(b, \[\]byte\{'a', 'b'\}\)`
	_ = bytes.Contains(b, []byte{0: '\n'})  // want `bytes\.Contains\(b, \[\]byte\{0: '\\n'\}\)`
	_ = bytes.IndexByte(b, '\n') >= 0       // want `bytes\.IndexByte\(b, '\\n'\) >= 0`
	_ = bytes.IndexByte(b, "="[0]) < 0      // want `bytes\.IndexByte\(b, "="\[0\]\) < 0`
	_ = bytes.IndexByte(b, sepByte) >= 0    // want `bytes\.IndexByte\(b, sepByte\) >= 0`
	_ = bytes.IndexByte(b, next()) >= 0     // want `bytes\.IndexByte\(b, next\(\)\) >= 0`
	_ = bytes.Contains(b, []byte("=>"))     // want `bytes\.Contains\(b, \[\]byte\("=>"\)\)`
}

// The argument expressions carry over byte-verbatim: struct fields,
// index expressions, calls, and redundant parens all stay exactly as
// written and are evaluated exactly once either way. A comment BETWEEN
// the arguments sits in kept text and survives the rewrite.
type payload struct{ text string }

func args(p payload, parts []string, get func() string) {
	if strings.Contains(p.text, "=>") { // want `strings\.Contains\(p\.text, "=>"\)`
		return
	}
	for !strings.Contains(parts[0], "=>") { // want `!strings\.Contains\(parts\[0\], "=>"\)`
		break
	}
	_ = strings.Contains(get(), "=>")            // want `strings\.Contains\(get\(\), "=>"\)`
	_ = strings.Contains(p.text /* mid */, "=>") // want `allocates the up-to-two-piece slice`
}

// Redundant parens around the len call, the SplitN call, the SplitN
// selector, the separator, or the limit are scaffolding and are
// consumed with it (the kept separator keeps its own parens).
func parens(s string) {
	_ = strings.Contains(s, "=>")         // want `allocates the up-to-two-piece slice`
	_ = strings.Contains(s, "=>")         // want `allocates the up-to-two-piece slice`
	_ = strings.Contains(s, "=>")         // want `allocates the up-to-two-piece slice`
	_ = strings.Contains(s, "=>")         // want `allocates the up-to-two-piece slice`
	_ = strings.Contains(s, ("=>"))       // want `allocates the up-to-two-piece slice`
	_ = strings.IndexByte(s, "="[0]) >= 0 // want `allocates the up-to-two-piece slice`
	_ = strings.Contains(s, "=>")         // want `allocates the up-to-two-piece slice`
}

// A call (or a !-prefixed call) binds tighter than any binary
// operator, so the rewrite needs no parentheses inside a larger
// condition; the chained IndexByte comparison stands where a
// comparison already stood.
func condition(ok bool, s string) bool {
	_ = ok && strings.IndexByte(s, "="[0]) < 0 // want `allocates the up-to-two-piece slice`
	return ok && !strings.Contains(s, "=>")    // want `allocates the up-to-two-piece slice`
}

// A comment inside the scaffolding the fix would delete withholds the
// automatic fix: the report stays advisory and the comment survives.
func commentAdvisory(s string) {
	_ = len( /* keep me */ strings.SplitN(s, "=>", 2)) == 2 // want `a comment inside the rewritten syntax withholds the automatic fix — rewrite by hand`
	_ = len(strings.SplitN(s, "=>", 2)) == /* two */ 2      // want `a comment inside the rewritten syntax withholds the automatic fix — rewrite by hand`
	_ = len(strings.SplitN(s, "=>" /* tail */, 2)) == 2     // want `a comment inside the rewritten syntax withholds the automatic fix — rewrite by hand`
}

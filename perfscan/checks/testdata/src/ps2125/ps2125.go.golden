package ps2125

import "unicode/utf8"

func process(int) {}

// Basic assignment; the file has no unicode/utf8 import yet, so the
// first rune-form fix adds it.
func runeCount(s string) int {
	n := utf8.RuneCountInString(s) // want `len\(\[\]rune\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
	return n
}

// Inside a larger expression: the replacement is a call — a primary
// expression — so no parentheses are ever needed.
func runeCountExpr(s string) int {
	n := utf8.RuneCountInString(s) + 1 // want `len\(\[\]rune\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
	return n
}

// Call-argument context.
func runeArg(s string) {
	process(utf8.RuneCountInString(s)) // want `len\(\[\]rune\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
}

// An untyped string constant operand defaults to string.
func runeLit() int {
	return utf8.RuneCountInString("héllo wörld") // want `len\(\[\]rune\("héllo wörld"\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\("héllo wörld"\) is the bit-identical count with zero allocation`
}

// []int32 spells the identical []rune type.
func runeInt32(s string) int {
	return utf8.RuneCountInString(s) // want `len\(\[\]int32\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
}

// []byte form: only the conversion is dropped, the outer len stays.
func byteCount(s string) int {
	return len(s) // want `len\(\[\]byte\(s\)\) copies the whole string just to take its length; len\(s\) is the identical byte count with zero allocation`
}

// []byte inside a larger expression: still just len(s), the surrounding
// len call already delimits it.
func byteExpr(s string) int {
	return 2 * len(s) // want `len\(\[\]byte\(s\)\) copies the whole string just to take its length; len\(s\) is the identical byte count with zero allocation`
}

// []uint8 spells the identical []byte type.
func byteUint8(s string) int {
	return len(s) // want `len\(\[\]uint8\(s\)\) copies the whole string just to take its length; len\(s\) is the identical byte count with zero allocation`
}

// Reported but NOT fixed: a comment inside the rewritten scaffolding
// would be destroyed by the edits.
func commentedRune(s string) int {
	return len( // keep me // want `len\(\[\]rune\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
		[]rune(s))
}

func commentedByte(s string) int {
	return len([]byte( // keep me // want `len\(\[\]byte\(s\)\) copies the whole string just to take its length; len\(s\) is the identical byte count with zero allocation`
		s))
}

// The utf8 qualifier is shadowed at the call site: the rewrite could
// not reference the package — reported, no fix.
func shadowedUtf8(s string) int {
	utf8 := 0
	_ = utf8
	return len([]rune(s)) // want `len\(\[\]rune\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
}

// --- guards: none of the following may be reported ---

// Identity conversion of a []byte: the operand is not a string, there
// is no string copy to drop.
func notStringByte(b []byte) int {
	return len([]byte(b))
}

// Identity conversion of a []rune likewise.
func notStringRune(r []rune) int {
	return len([]rune(r))
}

// A named string type is skipped deliberately: only exactly string.
type myString string

func namedString(m myString) int {
	return len([]rune(m))
}

// Plain len of a string is already minimal.
func plainLen(s string) int {
	return len(s)
}

// The conversion stored in a variable first may have other consumers.
func storedFirst(s string) int {
	r := []rune(s)
	return len(r)
}

// A named slice type is not the canonical []rune spelling.
type runes []rune

func namedSliceType(s string) int {
	return len(runes(s))
}

// The outer call is not the builtin len.
func notLen(s string) int {
	return cap([]rune(s))
}

// A shadowed len is not the builtin.
func shadowedLen(s string) int {
	len := func([]rune) int { return 0 }
	return len([]rune(s))
}

package ps2125

import "unicode/utf8"

// unicode/utf8 is already imported: the fix reuses it and must not add
// a duplicate import.
func alreadyImported(s string) bool {
	n := utf8.RuneCountInString(s) // want `len\(\[\]rune\(s\)\) decodes and allocates the whole rune slice just to count it; utf8\.RuneCountInString\(s\) is the bit-identical count with zero allocation`
	return n > 0 && utf8.ValidString(s)
}

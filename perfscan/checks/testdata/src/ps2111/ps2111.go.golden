package ps2111

import (
	"bytes"
	"io"
	"strings"
)

func direct(buf *bytes.Buffer, s string) {
	buf.WriteString(s) // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
}

// Both return (int, error): the results survive the rewrite.
func withResults(buf *bytes.Buffer, s string) (int, error) {
	return buf.WriteString(s) // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
}

// Pointer-receiver Write on an addressable value: the auto-address that
// made Write callable makes WriteString callable too.
func valueBuilder(s string) string {
	var sb strings.Builder
	sb.WriteString(s) // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
	return sb.String()
}

// An untyped string constant defaults to string.
func literal(buf *bytes.Buffer) {
	buf.WriteString("hello world") // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
}

// The argument expression is left in place untouched.
func concat(buf *bytes.Buffer, s, t string) {
	buf.WriteString(s + t) // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
}

type bothWriter interface {
	io.Writer
	io.StringWriter
}

// An interface receiver declaring both methods qualifies.
func viaInterface(w bothWriter, s string) {
	w.WriteString(s) // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
}

// Reported but NOT fixed: a comment inside the dropped conversion text
// would be destroyed by the rewrite.
func commented(buf *bytes.Buffer, s string) {
	buf.Write([]byte( /* keep me */ s)) // want `w\.Write\(\[\]byte\(s\)\) allocates and copies the string; the receiver implements io\.StringWriter, so w\.WriteString\(s\) writes it directly`
}

// --- guards: none of the following may be reported or rewritten ---

// io.Writer alone has no WriteString.
func plainWriter(w io.Writer, s string) {
	w.Write([]byte(s))
}

// A []byte argument — plain or through an identity conversion — is not a
// string.
func rawBytes(buf *bytes.Buffer, b []byte) {
	buf.Write(b)
	buf.Write([]byte(b))
}

// A named string type is not assignable to WriteString's string
// parameter; the rewrite would not compile.
type myString string

func namedString(buf *bytes.Buffer, ns myString) {
	buf.Write([]byte(ns))
}

// Value-receiver Write, pointer-receiver WriteString: on a
// non-addressable receiver WriteString is not callable.
type lopsided struct{}

func (lopsided) Write(p []byte) (int, error)        { return len(p), nil }
func (*lopsided) WriteString(s string) (int, error) { return len(s), nil }

func mkLopsided() lopsided { return lopsided{} }

func nonAddressable(s string) (int, error) {
	return mkLopsided().Write([]byte(s))
}

// Conservatively skipped even on an addressable value: callability of the
// pointer-receiver WriteString is not proven when Write itself did not
// need the auto-address.
func addressableButUnproven(s string) {
	var l lopsided
	l.Write([]byte(s))
}

// WriteString exists but not in io.StringWriter shape: the results would
// change type.
type oddSig struct{}

func (*oddSig) Write(p []byte) (int, error) { return len(p), nil }
func (*oddSig) WriteString(s string) error  { return nil }

func wrongSignature(w *oddSig, s string) {
	w.Write([]byte(s))
}

// perfscan monorepo workspace: independent, peer Go modules.
//   ./perfscan         — the Go performance linter (github.com/jxsl13/perfscan)
//   ./perfscan/plugin  — its golangci-lint plugin (own module to bound deps)
//   ./perfscanxx       — perfscan++ for C++, a clang-tidy orchestrator
// perfscan and perfscanxx do not import each other; the workspace only ties
// them for local dev.
go 1.24

use (
	./perfscan
	./perfscan/plugin
	./perfscanxx
)

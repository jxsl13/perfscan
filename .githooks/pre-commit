#!/bin/sh
# perfscan monorepo pre-commit hook: gofmt, vet, build, tests per module,
# plus perfscan self-scan. Install with `make hooks` (core.hooksPath=.githooks).
set -e

for mod in perfscan perfscanxx; do
	echo "pre-commit [$mod]: gofmt"
	out=$(cd "$mod" && gofmt -l $(git ls-files '*.go' | grep -v /testdata/ | sed "s#^$mod/##") 2>/dev/null)
	if [ -n "$out" ]; then
		echo "gofmt needed on (in $mod):"; echo "$out"; echo "run: gofmt -w $mod"; exit 1
	fi
	echo "pre-commit [$mod]: vet + build + test"
	( cd "$mod" && go vet ./... && go build ./... && go test ./... )
done

echo "pre-commit: perfscan self-scan (all levels)"
( cd perfscan && go run ./cmd/perfscan -level 3 ./... )

echo "pre-commit: ok"

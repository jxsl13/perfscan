#!/bin/sh
# Root-module pre-commit hook: gofmt, vet, build, parallel tests, and self-scan.
# Install with `make hooks` (core.hooksPath=.githooks).
set -e

echo "pre-commit: gofmt"
# Exclude testdata: analysistest fixtures need exact // want anchoring.
out=$(gofmt -l . | grep -v /testdata/ || true)
if [ -n "$out" ]; then
	echo "gofmt needed on:"; echo "$out"; echo "run: gofmt -w ."; exit 1
fi

echo "pre-commit: vet + build + parallel tests"
go vet ./...
go build ./...
go run ./internal/testparallel -workers 4 ./...

echo "pre-commit: self-scan (all levels)"
go run . -level 3 -baseline .perfscan-baseline.yaml ./...

echo "pre-commit: ok"

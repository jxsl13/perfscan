package ps5035

import (
	"strings"
)

// The predicate arguments are this file's ONLY unicode references, so
// the fix also drops the orphaned unicode import (the runner never
// prunes imports itself). The strings import stays: the rewrite keeps
// the qualifier and merely renames TrimFunc.
func basic(s string) string {
	return strings.TrimSpace(s) // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
}

// The source argument is kept byte-verbatim, however it is spelled: a
// field selector, a compound expression with a call (evaluated exactly
// once in both forms), a named string type (assignable to TrimFunc's
// and TrimSpace's identical string parameter), and a parenthesized
// predicate argument.
type name string

func verbatim(w struct{ s string }, f func() string, n name) {
	_ = strings.TrimSpace(w.s)       // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
	_ = strings.TrimSpace(f() + "!") // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
	_ = strings.TrimSpace(string(n)) // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
	_ = strings.TrimSpace(w.s)       // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
}

// A nested match sits inside the kept source-argument span: both sites
// are rewritten (the edits never overlap).
func nested(s string) string {
	return strings.TrimSpace(strings.TrimSpace(s)) // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes` `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
}

// A multi-line call keeps the source argument verbatim; the deleted
// span swallows the predicate and the trailing comma up to the closing
// parenthesis.
func multiline(s string) string {
	return strings.TrimSpace( // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
		s + s)
}

// A comment BEFORE the source argument sits in an untouched span and
// survives the rewrite.
func leadingComment(s string) string {
	return strings.TrimSpace( /* keep me */ s) // want `strings\.TrimFunc\(s, unicode\.IsSpace\) decodes`
}

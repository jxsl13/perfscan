package ps3030

import (
	"bytes"
)

// The two predicates below are this file's ONLY unicode references:
// applying both fixes orphans the import, so the fix drops it.
func orphanOne(b []byte) [][]byte {
	return bytes.Fields(b) // want `bytes\.FieldsFunc\(b, unicode\.IsSpace\) decodes every rune`
}

func orphanTwo(b []byte) [][][]byte {
	return [][][]byte{
		bytes.Fields(b), // want `bytes\.FieldsFunc\(b, unicode\.IsSpace\) decodes every rune`
	}
}

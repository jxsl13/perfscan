package ps3013

import (
	"fmt"
	"slices"
)

// Explicit instantiation brackets SURVIVE the rewrite: slices.Sort takes
// the same two type parameters as slices.SortFunc (and every fixable
// element type satisfies its cmp.Ordered constraint), so only the selector
// name changes and the comparator goes.
func sortInstantiated(xs []int) {
	slices.Sort[[]int, int](xs) // want `slices\.Sort sorts the int elements with the identical ascending order and a single inlined comparison`
	slices.Sort[[]int](xs)      // want `slices\.Sort sorts the int elements with the identical ascending order and a single inlined comparison`
	fmt.Println(xs)
}

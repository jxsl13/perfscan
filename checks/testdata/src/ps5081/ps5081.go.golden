	return dsa.Verify(publicKey, digest, r, s) // want "crypto/dsa.Verify read-only observation consumes 1 throwaway clone layer"
}

func verifyECDSA(publicKey *ecdsa.PublicKey, digest []byte, r, s *big.Int) bool {
	return ecdsa.Verify(publicKey, digest, r, s) // want "crypto/ecdsa.Verify read-only observation consumes 1 throwaway clone layer"

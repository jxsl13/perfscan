	return ecdsa.VerifyASN1(publicKey, digest, signature) // want "crypto/ecdsa.VerifyASN1 read-only observation consumes 2 throwaway clone layer"
}

func verifyRSAPKCS1v15(publicKey *rsa.PublicKey, digest, signature []byte) error {
	return rsa.VerifyPKCS1v15(publicKey, crypto.SHA256, digest, signature) // want "crypto/rsa.VerifyPKCS1v15 read-only observation consumes 2 throwaway clone layer"
}


package ps6010

func localLenShadowRound14(a [4]float64, weights [16]float64, out, n int) [4]float64 {
	len := 7
	_ = len
	var dst [4]float64
	for o := 0; o < out; o++ {
		acc := 0.0
		for i := 0; i < n; i++ {
			acc += a[i] * weights[i*out+o] // want `this operand does not vary with the output index o but is re-streamed once per output element; unroll the output loop by 4 with independent accumulators to amortize the load \(bit-identical per output\)`
		}
		dst[o] = acc
	}
	return dst
}

func parameterLenShadowRound14(a [4]float64, weights [16]float64, out, n, len int) [4]float64 {
	_ = len
	var dst [4]float64
	for o := 0; o < out; o++ {
		acc := 0.0
		for i := 0; i < n; i++ {
			acc += a[i] * weights[i*out+o] // want `this operand does not vary with the output index o but is re-streamed once per output element; unroll the output loop by 4 with independent accumulators to amortize the load \(bit-identical per output\)`
		}
		dst[o] = acc
	}
	return dst
}

func unshadowedLenControlRound14(a [4]float64, weights [16]float64, out, n int) [4]float64 {
	var dst [4]float64
	psO1085 := 0
	if out <= 0 || (out <= len(dst) && (n <= 0 || (n <= len(a) && n <= len(weights)/out))) {
		for ; psO1085 < out && out-psO1085 >= 4; psO1085 += 4 {
			a0, a1, a2, a3 := 0.0, 0.0, 0.0, 0.0
			for i := 0; i < n; i++ {
				ai := a[i]
				a0 += ai * weights[i*out+psO1085]
				a1 += ai * weights[i*out+psO1085+1]
				a2 += ai * weights[i*out+psO1085+2]
				a3 += ai * weights[i*out+psO1085+3]
			}
			dst[psO1085], dst[psO1085+1], dst[psO1085+2], dst[psO1085+3] = a0, a1, a2, a3
		}
		for ; psO1085 < out; psO1085++ {
			acc := 0.0
			for i := 0; i < n; i++ {
				acc += a[i] * weights[i*out+psO1085]
			}
			dst[psO1085] = acc
		}
	} else {
		for ; psO1085 < out; psO1085++ {
			acc := 0.0
			for i := 0; i < n; i++ {
				acc += a[i] * weights[i*out+psO1085]
			}
			dst[psO1085] = acc
		}
	}
	return dst
}

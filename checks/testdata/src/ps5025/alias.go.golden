package ps5025

import (
	buf "bytes"
	str "strings"
)

// An aliased strings/bytes import keeps its qualifier verbatim; only the
// selected name and the wrapped literal change — LastIndexByte lives in
// the same package, so no import surgery is ever needed.
func aliased(s string, b []byte) int {
	i := str.LastIndexByte(s, "@"[0]) // want `strings\.LastIndexAny of the one-ASCII-byte cutset "@" pays the cutset dispatch`
	j := buf.LastIndexByte(b, "#"[0]) // want `bytes\.LastIndexAny of the one-ASCII-byte cutset "#" pays the cutset dispatch`
	return i + j
}

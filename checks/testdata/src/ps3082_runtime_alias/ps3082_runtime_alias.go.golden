package ps3082_runtime_alias

import (
	m "math"
	rt "runtime"
)

var _ = rt.GOARCH

func maximum(values []float64) float64 {
	result := m.Inf(-1)
	for _, value := range values {
		result = psFmax(result, value) // want `math\.Max in a data-scaled loop can stay an out-of-line architecture call per iteration; use the exact architecture-aware max-builtin helper, validate signed-zero/infinity/NaN raw bits on every target, and retain it only after a complete-operation benchmark`
	}
	return result
}

// psFmax preserves math.Max bit for bit while keeping its common path inline
// (see perfscan PS3082).
func psFmax(a, b float64) float64 {
	if rt.GOARCH == "arm64" {
		const positiveInfinityBits = uint64(0x7ff0000000000000)
		positiveInfinity := m.Float64frombits(positiveInfinityBits)
		if a == positiveInfinity || b == positiveInfinity {
			return positiveInfinity
		}
		return max(b, a)
	}
	if r := max(a, b); r == r {
		return r
	}
	return m.Max(a, b)
}

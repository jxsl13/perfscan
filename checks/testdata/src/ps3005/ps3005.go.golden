package ps3005

import "sort"

func indirect(idx []int, m [][]float64, f int) {
	psKey6 := make([]float64, len(m))
	for psI := range m {
		psKey6[psI] = m[psI][f]
	}
	sort.Slice(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		return psKey6[idx[a]] < psKey6[idx[b]]
	})
}

// Descending order is the same shape with a and b swapped; the rewrite keeps
// the predicate, so it is fixable too.
func indirectDesc(idx []int, m [][]float64, f int) {
	psKey14 := make([]float64, len(m))
	for psI := range m {
		psKey14[psI] = m[psI][f]
	}
	sort.SliceStable(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		return psKey14[idx[b]] < psKey14[idx[a]]
	})
}

type conf struct{ col int }

// A selector-chain key index is invariant and simple: fixable.
func indirectSel(idx []int, m [][]int, c conf) {
	psKey23 := make([]int, len(m))
	for psI := range m {
		psKey23[psI] = m[psI][c.col]
	}
	sort.Slice(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		return psKey23[idx[a]] < psKey23[idx[b]]
	})
}

// The key index is a call: not invariant by inspection, advisory only.
func advisoryCallIndex(idx []int, m [][]float64, g func() int) {
	sort.Slice(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		return m[idx[a]][g()] < m[idx[b]][g()]
	})
}

// A map cannot be prefilled row-for-row into make([]T, len(m)): advisory only.
func advisoryMap(idx []int, m map[int][]float64, f int) {
	sort.Slice(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		return m[idx[a]][f] < m[idx[b]][f]
	})
}

// Extra work in the comparator body: advisory only.
func advisoryBody(idx []int, m [][]float64, f int) {
	sort.Slice(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		d := m[idx[a]][f]
		return d < m[idx[b]][f]
	})
}

// Not a plain '<' predicate: advisory only.
func advisoryOp(idx []int, m [][]float64, f int) {
	sort.Slice(idx, func(a, b int) bool { // want `the comparator sorting idx dereferences m\[idx\[…\]\]\[…\] on every comparison — a row-pointer load plus an index, O\(n log n\) times, for a value that depends only on the element; fill a flat id-indexed key column once and compare that \(same predicate, identical permutation\)`
		return m[idx[a]][f] >= m[idx[b]][f]
	})
}

// A flat key is the fixed form: applying the advice clears the finding.
func flatKey(idx []int, key []float64) {
	sort.Slice(idx, func(a, b int) bool {
		return key[idx[a]] < key[idx[b]]
	})
}

// Sorting the data itself (not an index slice): no double dereference.
func direct(xs []float64) {
	sort.Slice(xs, func(a, b int) bool {
		return xs[a] < xs[b]
	})
}

package ps5069

import (
	"bytes"
	"strings"
)

// A residual strings use so the rewrite never orphans the strings import
// (the fix is withheld file-wide otherwise, mirroring PS5050).
func keep(s string) string { return strings.ToUpper(s) }

func hasPrefix(buf bytes.Buffer) bool {
	return bytes.HasPrefix(buf.Bytes(), []byte("GET ")) // want `strings\.HasPrefix over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

func hasSuffix(buf bytes.Buffer) bool {
	return bytes.HasSuffix(buf.Bytes(), []byte("\r\n")) // want `strings\.HasSuffix over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

func contains(buf bytes.Buffer) bool {
	return bytes.Contains(buf.Bytes(), []byte("\n\n")) // want `strings\.Contains over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

func equalFold(buf bytes.Buffer) bool {
	return bytes.EqualFold(buf.Bytes(), []byte("OK")) // want `strings\.EqualFold over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

func index(buf bytes.Buffer) int {
	return bytes.Index(buf.Bytes(), []byte("sep")) // want `strings\.Index over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

func lastIndex(buf bytes.Buffer) int {
	return bytes.LastIndex(buf.Bytes(), []byte("sep")) // want `strings\.LastIndex over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

func count(buf bytes.Buffer) int {
	return bytes.Count(buf.Bytes(), []byte("x")) // want `strings\.Count over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

// A pointer receiver taken by &buf is provably non-nil: fixed.
func pointerAddr(buf bytes.Buffer) bool {
	return bytes.HasPrefix((&buf).Bytes(), []byte("GET ")) // want `strings\.HasPrefix over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

// new(bytes.Buffer) is provably non-nil: fixed.
func pointerNew() bool {
	return bytes.HasPrefix(new(bytes.Buffer).Bytes(), []byte("GET ")) // want `strings\.HasPrefix over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

// A named string constant carries over verbatim into the []byte conversion.
const prefix = "POST "

func namedConst(buf bytes.Buffer) bool {
	return bytes.HasPrefix(buf.Bytes(), []byte(prefix)) // want `strings\.HasPrefix over buf\.String\(\) copies the whole bytes\.Buffer just to test it against a constant`
}

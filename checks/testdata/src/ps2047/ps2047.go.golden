package ps2047

import (
	"strconv"
	sc "strconv"
)

type buffer []byte

func nextInt() int64 { return 42 }

// --- fixable: dst is the unnamed []byte ---

// Itoa has no direct Append twin: AppendInt with a value-preserving
// int64(...) wrap and the explicit base 10 (Itoa is FormatInt(int64(i), 10)).
func itoa(dst []byte, n int) []byte {
	return strconv.AppendInt(dst, int64(n), 10) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

// The whole argument expression is wrapped: int64(n + 1).
func itoaExpr(dst []byte, n int) []byte {
	dst = strconv.AppendInt(dst, int64(n+1), 10) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
	return dst
}

// Format* keeps every argument verbatim; only dst moves inside.
func formatInt(dst []byte, x int64, base int) []byte {
	return strconv.AppendInt(dst, x, base) // want `append\(dst, strconv\.FormatInt\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

func formatUint(dst []byte, u uint64) []byte {
	return strconv.AppendUint(dst, u, 16) // want `append\(dst, strconv\.FormatUint\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendUint\(dst, \.\.\.\) formats straight into dst`
}

func formatFloat(dst []byte, f float64) []byte {
	return strconv.AppendFloat(dst, f, 'g', -1, 64) // want `append\(dst, strconv\.FormatFloat\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendFloat\(dst, \.\.\.\) formats straight into dst`
}

// A dynamic bitSize may be invalid. Since Go 1.27, FormatFloat and
// AppendFloat expose different panic values through recover, so this reports
// the opportunity but deliberately has no SuggestedFix.
func formatFloatDynamic(dst []byte, f float64, bitSize int) []byte {
	return append(dst, strconv.FormatFloat(f, 'g', -1, bitSize)...) // want `append\(dst, strconv\.FormatFloat\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendFloat\(dst, \.\.\.\) formats straight into dst; bitSize is not a compile-time 32 or 64`
}

func formatFloatInvalid(dst []byte, f float64) []byte {
	return append(dst, strconv.FormatFloat(f, 'g', -1, 16)...) // want `append\(dst, strconv\.FormatFloat\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendFloat\(dst, \.\.\.\) formats straight into dst; bitSize is not a compile-time 32 or 64`
}

func formatBool(dst []byte, b bool) []byte {
	return strconv.AppendBool(dst, b) // want `append\(dst, strconv\.FormatBool\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendBool\(dst, \.\.\.\) formats straight into dst`
}

func quote(dst []byte, s string) []byte {
	return strconv.AppendQuote(dst, s) // want `append\(dst, strconv\.Quote\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendQuote\(dst, \.\.\.\) formats straight into dst`
}

func quoteToASCII(dst []byte, s string) []byte {
	return strconv.AppendQuoteToASCII(dst, s) // want `append\(dst, strconv\.QuoteToASCII\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendQuoteToASCII\(dst, \.\.\.\) formats straight into dst`
}

func quoteRune(dst []byte, r rune) []byte {
	return strconv.AppendQuoteRune(dst, r) // want `append\(dst, strconv\.QuoteRune\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendQuoteRune\(dst, \.\.\.\) formats straight into dst`
}

func quoteRuneToGraphic(dst []byte, r rune) []byte {
	return strconv.AppendQuoteRuneToGraphic(dst, r) // want `append\(dst, strconv\.QuoteRuneToGraphic\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendQuoteRuneToGraphic\(dst, \.\.\.\) formats straight into dst`
}

// A parenthesized spread argument still matches; the redundant
// parentheses vanish with the scaffolding.
func parens(dst []byte, n int) []byte {
	return strconv.AppendInt(dst, int64(n), 10) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

// An aliased strconv import keeps its qualifier: the rewrite is rendered
// from the source selector, so it compiles under the alias.
func aliased(dst []byte, n int) []byte {
	return sc.AppendInt(dst, int64(n), 10) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

// A side-effecting argument passes through verbatim: evaluated exactly
// once in both spellings, after dst, in the same order.
func sideEffect(dst []byte) []byte {
	return strconv.AppendInt(dst, nextInt(), 10) // want `append\(dst, strconv\.FormatInt\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

// dst may be any []byte-typed expression; it is kept verbatim too.
func indexedDst(bufs [][]byte, i, n int) {
	bufs[i] = strconv.AppendInt(bufs[i], int64(n), 10) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

// --- advisory: dst has a NAMED byte-slice type ---

// append returns dst's own named type; strconv.AppendInt returns []byte —
// the rewrite would change the expression's static type, so the report
// stays advisory.
func namedDst(b buffer, n int) buffer {
	return append(b, strconv.Itoa(n)...) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst; dst's static type is not the plain \[\]byte and strconv\.AppendInt returns \[\]byte, so the rewrite would change the expression's static type — rewrite by hand if nothing relies on it`
}

// A generic ~[]byte destination is a type parameter, not the plain
// []byte — advisory likewise.
func genericDst[S ~[]byte](dst S, n int) S {
	return append(dst, strconv.Itoa(n)...) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst; dst's static type is not the plain \[\]byte and strconv\.AppendInt returns \[\]byte, so the rewrite would change the expression's static type — rewrite by hand if nothing relies on it`
}

// --- advisory: a comment inside the rewritten scaffolding ---

func commentedDst(dst []byte, n int) []byte {
	return append(dst /* keep */, strconv.Itoa(n)...) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

func commentedClose(dst []byte, n int) []byte {
	return append(dst, strconv.Itoa(n)... /* keep */) // want `append\(dst, strconv\.Itoa\(\.\.\.\)\.\.\.\) formats a throwaway string that append copies a second time; strconv\.AppendInt\(dst, \.\.\.\) formats straight into dst`
}

// --- silent negatives ---

// FormatComplex has no Append* twin — silent.
func formatComplex(dst []byte, c complex128) []byte {
	return append(dst, strconv.FormatComplex(c, 'g', -1, 128)...)
}

// A plain string spread has no formatter call to fuse — silent.
func plainString(dst []byte, s string) []byte {
	return append(dst, s...)
}

// A []byte conversion spread is a different pattern (PS5020) — silent here.
func byteSliceConv(dst []byte, s string) []byte {
	return append(dst, []byte(s)...)
}

// The formatted string used on its own is not the pattern.
func keepString(n int) string {
	return strconv.Itoa(n)
}

// Not a spread — silent.
func nonSpread(dst []byte, a, b byte) []byte {
	return append(dst, a, b)
}

// An Itoa on a value named strconv is not the standard library — silent.
type fake struct{}

func (fake) Itoa(n int) string { return "" }

func localShadow(dst []byte, n int) []byte {
	var strconv fake
	return append(dst, strconv.Itoa(n)...)
}

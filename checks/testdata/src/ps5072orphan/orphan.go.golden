package ps5072orphan

import (
	"hash/maphash"
)

func sum(h *maphash.Hash) uint64 {
	return h.Sum64() // want `binary\.LittleEndian\.Uint64\(h\.Sum\(nil\)\) makes and decodes an 8-byte representation`
}

func sumAgain(h *maphash.Hash) uint64 {
	return h.Sum64() // want `binary\.LittleEndian\.Uint64\(h\.Sum\(nil\)\) makes and decodes an 8-byte representation`
}

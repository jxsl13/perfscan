func nestedOptionalTailGuardExclusiveBranchesStillSerial(a, b [][]float64, c []float64, cols int, flag bool) {
	for i := range a {
		for j := 0; j+3 < cols; j += 4 {
			var s0, s1, s2, s3 float64
			for k := range b { // want `innermost loop of this nest is a serial scalar dot accumulator running at FMA latency, not throughput; an ikj/axpy order or an accumulator block breaks the chain \(reassociation is not bit-identical — gate with a tolerance oracle\)`
				s0 += a[i][k] * b[k][j]
				if j+1 < cols {
					if flag {
						s1 += a[i][k] * b[k][j+1]
					} else {
						s2 += a[i][k] * b[k][j+2]
					}
				}
				if j+2 < cols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < cols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3
		}
	}
}

func nestedOptionalTailGuardDifferentAccumulatorsEachPathSilent(a, b [][]float64, c []float64, cols int, flag bool) {
	for i := range a {
		for j := 0; j+3 < cols; j += 4 {
			var s0, s1, s2, s3, alt float64
			for k := range b {
				s0 += a[i][k] * b[k][j]
				if j+1 < cols {
					if flag {
						s1 += a[i][k] * b[k][j+1]
					} else {
						alt += a[i][k] * b[k][j+1]
					}
				}
				if j+2 < cols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < cols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3 + alt
		}
	}
}

// Optional output lanes do not prove a four-way accumulator tile when their
// shared bound is assigned during the serial loop.
func assignedOptionalTailBoundStillSerial(a, b [][]float64, c []float64, cols int) {
	for i := range a {
		for j := 0; j+3 < cols; j += 4 {
			var s0, s1, s2, s3 float64
			for k := range b { // want `innermost loop of this nest is a serial scalar dot accumulator running at FMA latency, not throughput; an ikj/axpy order or an accumulator block breaks the chain \(reassociation is not bit-identical — gate with a tolerance oracle\)`
				s0 += a[i][k] * b[k][j]
				cols--
				if j+1 < cols {
					s1 += a[i][k] * b[k][j+1]
				}
				if j+2 < cols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < cols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3
		}
	}
}

// Taking the bound's address exposes it to mutation and invalidates the same
// optional-tail proof.
func escapedOptionalTailBoundStillSerial(a, b [][]float64, c []float64, cols int) {
	for i := range a {
		for j := 0; j+3 < cols; j += 4 {
			var s0, s1, s2, s3 float64
			for k := range b { // want `innermost loop of this nest is a serial scalar dot accumulator running at FMA latency, not throughput; an ikj/axpy order or an accumulator block breaks the chain \(reassociation is not bit-identical — gate with a tolerance oracle\)`
				s0 += a[i][k] * b[k][j]
				mutatePS4008Index(&cols)
				if j+1 < cols {
					s1 += a[i][k] * b[k][j+1]
				}
				if j+2 < cols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < cols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3
		}
	}
}

// The bound can escape before either loop starts. An indirect write through
// that old alias still invalidates optional-lane coverage inside the dot loop.
func priorEscapedOptionalTailBoundStillSerial(a, b [][]float64, c []float64, cols int) {
	p := &cols
	for i := range a {
		for j := 0; j+3 < cols; j += 4 {
			var s0, s1, s2, s3 float64
			for k := range b { // want `innermost loop of this nest is a serial scalar dot accumulator running at FMA latency, not throughput; an ikj/axpy order or an accumulator block breaks the chain \(reassociation is not bit-identical — gate with a tolerance oracle\)`
				s0 += a[i][k] * b[k][j]
				mutatePS4008Index(p)
				if j+1 < cols {
					s1 += a[i][k] * b[k][j+1]
				}
				if j+2 < cols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < cols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3
		}
	}
}

// A closure defined before the output loop can mutate the optional-lane bound
// even though its call does not directly name cols.
func priorClosureOptionalTailBoundStillSerial(a, b [][]float64, c []float64, cols int) {
	mutate := func() { cols = 1 }
	for i := range a {
		for j := 0; j+3 < cols; j += 4 {
			var s0, s1, s2, s3 float64
			for k := range b { // want `innermost loop of this nest is a serial scalar dot accumulator running at FMA latency, not throughput; an ikj/axpy order or an accumulator block breaks the chain \(reassociation is not bit-identical — gate with a tolerance oracle\)`
				s0 += a[i][k] * b[k][j]
				mutate()
				if j+1 < cols {
					s1 += a[i][k] * b[k][j+1]
				}
				if j+2 < cols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < cols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3
		}
	}
}

var ps4008PackageCols = 8

func mutatePS4008PackageCols() { ps4008PackageCols++ }

// An impure call in the serial loop may change a package-scope optional-lane
// bound even when it has no explicit argument naming that bound.
func packageBoundCallEffectStillSerial(a, b [][]float64, c []float64) {
	for i := range a {
		for j := 0; j+3 < ps4008PackageCols; j += 4 {
			var s0, s1, s2, s3 float64
			for k := range b { // want `innermost loop of this nest is a serial scalar dot accumulator running at FMA latency, not throughput; an ikj/axpy order or an accumulator block breaks the chain \(reassociation is not bit-identical — gate with a tolerance oracle\)`
				s0 += a[i][k] * b[k][j]
				mutatePS4008PackageCols()
				if j+1 < ps4008PackageCols {
					s1 += a[i][k] * b[k][j+1]
				}
				if j+2 < ps4008PackageCols {
					s2 += a[i][k] * b[k][j+2]
				}
				if j+3 < ps4008PackageCols {
					s3 += a[i][k] * b[k][j+3]
				}
			}
			c[j] = s0 + s1 + s2 + s3
		}
	}
}

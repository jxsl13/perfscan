package ps5125

import (
	"bytes"
	"strings"
)

const (
	colonA = ":"
	colonB = ":"
)

func assign(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = strings.Replace(value, ":", "-", 1)
	return value
}

func named(value, old, replacement string, limit int) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = strings.Replace(value, old, replacement, limit)
	return value
}

func equalConstants(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = strings.Replace(value, colonB, ";", 2)
	return value
}

func emptyOld(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = strings.Replace(value, "", "|", 3)
	return value
}

func zeroLimit(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = strings.Replace(value, ":", "-", 0)
	return value
}

func allReplacements(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = strings.Replace(value, ":", "-", -1)
	return value
}

func earlyReturn(value, old, replacement string, limit int) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	return strings.Replace(value, old, replacement, limit)
}

func elseReturn(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	return strings.Replace(value, ":", "-", 1)
}

func initializedOutput(value string) string {
	// want +2 `strings.Contains scans before strings.Replace repeats the same lookup`
	output := strings.Replace(value, ":", "-", 1)
	return output
}

func assignmentElseOutput(value, output string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	output = strings.Replace(value, ":", "-", 1)
	return output
}

func parenthesized(value string) string {
	// want +1 `strings.Contains scans before strings.Replace repeats the same lookup`
	value = (strings.Replace((value), (":"), ("-"), (1)))
	return value
}

// --- negatives ---

func differentTarget(value, output string) string {
	if strings.Contains(value, ":") {
		output = strings.Replace(value, ":", "-", 1)
	}
	return output
}

func differentInput(value, other string) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(other, ":", "-", 1)
	}
	return value
}

func differentOld(value string) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(value, ";", "-", 1)
	}
	return value
}

func effectfulReplacement(value string, replacement func() string) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(value, ":", replacement(), 1)
	}
	return value
}

func effectfulLimit(value string, limit func() int) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(value, ":", "-", limit())
	}
	return value
}

func selectedOperands(value string, holder struct {
	replacement string
	limit       int
}) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(value, ":", holder.replacement, holder.limit)
	}
	return value
}

func additionalWork(value string) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(value, ":", "-", 1)
		value += "!"
	}
	return value
}

func initializedCondition(value string) string {
	if enabled := true; enabled && strings.Contains(value, ":") {
		value = strings.Replace(value, ":", "-", 1)
	}
	return value
}

func negated(value string) string {
	if !strings.Contains(value, ":") {
		value = strings.Replace(value, ":", "-", 1)
	}
	return value
}

func compound(value string, enabled bool) string {
	if enabled && strings.Contains(value, ":") {
		value = strings.Replace(value, ":", "-", 1)
	}
	return value
}

func wrongElse(value string) string {
	if strings.Contains(value, ":") {
		value = strings.Replace(value, ":", "-", 1)
	} else {
		value = "absent"
	}
	return value
}

func delayedFallback(value string) string {
	if strings.Contains(value, ":") {
		return strings.Replace(value, ":", "-", 1)
	}
	value += ""
	return value
}

func shortDeclaration(value string) string {
	if strings.Contains(value, ":") {
		output := strings.Replace(value, ":", "-", 1)
		return output
	}
	return value
}

func byteSlice(value []byte) []byte {
	if bytes.Contains(value, []byte(":")) {
		value = bytes.Replace(value, []byte(":"), []byte("-"), 1)
	}
	return value
}

func replaceAll(value string) string {
	if strings.Contains(value, ":") {
		value = strings.ReplaceAll(value, ":", "-")
	}
	return value
}

func functionValues(value string) string {
	contains, replace := strings.Contains, strings.Replace
	if contains(value, ":") {
		value = replace(value, ":", "-", 1)
	}
	return value
}

type helper string

func (value helper) Contains(old string) bool { return len(old) != 0 }
func (value helper) Replace(old, replacement string, limit int) helper {
	return value + helper(old) + helper(replacement)
}

func methods(value helper) helper {
	if value.Contains(":") {
		value = value.Replace(":", "-", 1)
	}
	return value
}

var _ = []any{
	assign, named, equalConstants, emptyOld, zeroLimit, allReplacements,
	earlyReturn, elseReturn, initializedOutput, assignmentElseOutput,
	parenthesized, differentTarget, differentInput, differentOld,
	effectfulReplacement, effectfulLimit, selectedOperands, additionalWork,
	initializedCondition, negated, compound, wrongElse, delayedFallback,
	shortDeclaration, byteSlice, replaceAll, functionValues, methods,
}
